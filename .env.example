DATABASE_URL=postgresql://username:password@localhost:5432/music_operations
ENGINE_API_KEY=replace-with-a-random-secret-at-least-32-characters
PORT=4000
# CORS_ORIGIN=https://your-command-center.example
# ENGINE_CREDENTIALS is a JSON array of server-side credentials, never browser configuration.
# Each entry: {"id":"command-center","key":"<random-secret-at-least-32-characters>","labels":["label-id"],"permissions":["read"]}
# Optional sources allowlist applies to ingestion and reporting.
# TRACKZERO_WEBHOOK_SECRET=<random-source-signing-secret-at-least-32-characters>
# SCENESIGNAL_WEBHOOK_SECRET=<different-random-signing-secret-at-least-32-characters>

# Required before storing provider credentials: 32 random bytes encoded as base64, held in the deployment secret manager.\n# CONNECTOR_MASTER_KEY=<base64-encoded-32-byte-key>\n